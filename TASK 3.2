#TASK 3.2
x =input("Enter an encrypted msg: ")
key =int(input("Enter a key: "))
encrypted_message = ""
msg = x.lower()
for char in msg :
    if 'a' <= char <= 'z' :
        position = ord(char) - ord('a')
        newpos = (position - key) % 26
        newchar  = chr ( newpos  + ord('a'))
        encrypted_message += newchar 
    else : 
        encrypted_message += char

print(encrypted_message)
