#TASK 1.5
x = int(input("Enter a number: "))
output = ""

if x == 42:
    output += "a"
if x <= 21:
    output += "b"
if x % 2 == 0:
    output += "c"
if x / 2 < 21:
    output += "d"
if x % 2 != 0 and x >= 45:
    output += "e"

if not output:
    output = "f"

print(output)



